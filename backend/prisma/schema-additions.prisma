// ---- Supplier payments (needed for the AP → Cash posting rule) -----------
// Not yet in your schema — PurchaseOrder/GoodsReceipt track what was
// ordered/received, but nothing tracks cash actually leaving for it.

model SupplierPayment {
  id              String   @id @default(uuid())
  organizationId  String
  purchaseOrderId String
  amount          Decimal  @db.Decimal(12, 2)
  method          PaymentMethod @default(TRANSFER)
  paidAt          DateTime @default(now())
  note            String?
  recordedById    String?
  createdAt       DateTime @default(now())

  // NEW — which specific bank account this went out of. Required
  // (enforced in SupplierPaymentsService) whenever method != CASH.
  bankAccountId String?
  bankAccount   OrganizationBankAccount? @relation(fields: [bankAccountId], references: [id])

  organization  Organization  @relation(fields: [organizationId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  recordedBy    User?         @relation(fields: [recordedById], references: [id])

  @@index([purchaseOrderId])
}

