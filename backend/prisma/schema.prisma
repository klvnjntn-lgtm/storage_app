  location       Location?              @relation(fields: [locationId, organizationId], references: [id, organizationId])
  organization   Organization           @relation(fields: [organizationId], references: [id])
  user           User?                  @relation(fields: [userId], references: [id])
  vehicle        Vehicle?               @relation(fields: [vehicleId, organizationId], references: [id, organizationId])
  salesOrder     SalesOrder?            @relation(fields: [salesOrderId], references: [id])
  activityEvents InvoiceActivityEvent[]
  items          InvoiceItem[]
  taxes          InvoiceTax[]
  payments       Payment[]
  session        Session?
  quotationId String?
  quotation   SalesQuotation? @relation(fields: [quotationId], references: [id])
  odometer      Int?
  nextServiceKm Int?

  discountType  DiscountType?
  discountValue Decimal?
  @@index([organizationId, employeeId])   // NEW

  @@unique([organizationId, invoiceNumber])
