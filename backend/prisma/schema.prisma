generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrganizationTaxRate {
  id                      String                  @id @default(uuid())
  organizationId          String
  name                    String
  percentage              Decimal                 @db.Decimal(5, 2)
  createdAt               DateTime                @default(now())
  archivedAt              DateTime?
  isDefault               Boolean                 @default(false)
  invoiceItemTaxes        InvoiceItemTax[]
  invoiceTaxes            InvoiceTax[]
  organization            Organization            @relation(fields: [organizationId], references: [id])
  salesQuotationTaxes     SalesQuotationTax[]
  salesQuotationItemTaxes SalesQuotationItemTax[]
  salesOrderTaxes         SalesOrderTax[]
  salesOrderItemTaxes     SalesOrderItemTax[]
  purchaseOrders          PurchaseOrder[]

  @@index([organizationId])
}

model InvoiceTax {
  id         String               @id @default(cuid())
  invoiceId  String
  taxRateId  String?
  name       String
  percentage Decimal              @db.Decimal(5, 2)
  amount     Decimal              @db.Decimal(12, 2)
  invoice    Invoice              @relation(fields: [invoiceId], references: [id])
  taxRate    OrganizationTaxRate? @relation(fields: [taxRateId], references: [id])

  @@index([invoiceId])
}

model Customer {
  id              String           @id @default(cuid())
  organizationId  String
  name            String
  phone           String?
  address         String?
  salesQuotations SalesQuotation[]
  salesOrders     SalesOrder[]
  deliveryOrders  DeliveryOrder[] // NEW — inverse of DeliveryOrder.customerId
  billingAddress  String?

  // NEW — default location for new deliveries to this customer. Set once
  // via a click-to-pin map (no geocoding service exists — same convention
  // as DeliveryOrder.destinationLatitude), copied onto a new DeliveryOrder
  // at creation time; that individual shipment's own pin can still
  // override it (job site, branch, third party — see that field's comment).
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  // DELIVERY_DMS — directions for the driver ("gate behind the mosque,
  // ring the bell twice"), shown on every route stop for this customer
  // together with locationPhotos.
  deliveryNotes  String?
  locationPhotos CustomerLocationPhoto[]
  routeStops     RouteStop[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  npwp         String?
  companyName  String?
  organization Organization      @relation(fields: [organizationId], references: [id])
  invoices     Invoice[]
  vehicles     Vehicle[]
  addresses    CustomerAddress[]

  // Price level this customer buys at (Wholesale, Member, …). New sales
  // lines for them start at this level; null = the org's default level.
  priceLevelId String?
  priceLevel   PriceLevel? @relation(fields: [priceLevelId], references: [id])

  @@unique([id, organizationId])
  @@unique([organizationId, npwp]) // FIX — tax ID must not repeat within an org; nullable, so multiple customers with no NPWP on file are still fine
  @@index([organizationId])
  @@index([organizationId, name])
}

// Extra saved delivery sites for a customer (branches, warehouses, job
// sites). Customer.address/latitude/longitude stays the default; picking
// one of these when creating a DeliveryOrder copies its address and pin
// onto that DO (snapshot — editing the saved address later doesn't move
// already-created shipments).
model CustomerAddress {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  label          String
  address        String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, customerId])
}

// DELIVERY_DMS — photos of the customer's building/entrance so a driver
// can recognise the place (max 2 per customer, CustomerLocationService).
// Private files under "customer-locations/", viewed via signed links like
// delivery proofs — a customer's premises aren't public media.
model CustomerLocationPhoto {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  storageKey     String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, customerId])
}

model Vehicle {
  id              String       @id @default(cuid())
  customerId      String
  plateNumber     String
  plateNormalized String // FIX — uppercase, separator-stripped form of plateNumber (e.g. "BP1234XX"), computed at write time by normalizePlate(); used only for format-agnostic lookup matching, never displayed
  vehicleModel    String
  vin             String?
  salesOrders     SalesOrder[]

  odometer       Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organizationId String
  invoices       Invoice[]
  customer       Customer          @relation(fields: [customerId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  reminders      VehicleReminder[]

  @@unique([id, organizationId])
  @@unique([organizationId, customerId, plateNumber])
  @@unique([organizationId, vin]) // FIX — VIN should identify one vehicle per org; nullable, so multiple vehicles with no VIN on file are still fine
  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, plateNormalized]) // FIX — supports vehicle-lookup search()/findByExactPlate()
}

model Organization {
  id                              String                @id @default(uuid())
  name                            String
  priceLevels                     PriceLevel[]
  supplierPayments                SupplierPayment[]
  plan                            String                @default("free")
  seatLimit                       Int                   @default(1)
  createdAt                       DateTime              @default(now())
  fulfillmentMode                 FulfillmentMode       @default(PICK_PACK_SHIP)
  posPricingEnabled               Boolean               @default(false)
  // When true, only admins may set a sales line to a price level other
  // than the customer's (mirrors stockOverrideRequiresAdmin).
  priceLevelOverrideRequiresAdmin Boolean               @default(false)
  stockPolicy                     StockPolicy           @default(BLOCK)
  stockOverrideRequiresAdmin      Boolean               @default(false)
  settingsAuditLogs               SettingsAuditLog[]
  documentSequences               DocumentSequence[]
  documentCounters                DocumentCounter[]
  employees                       Employee[]
  salaryComponentTypes            SalaryComponentType[]
  payrolls                        Payroll[]
  expenseCategories               ExpenseCategory[]
  expenses                        Expense[]
  chartOfAccounts                 ChartOfAccount[]
  fiscalPeriods                   FiscalPeriod[]
  journalEntries                  JournalEntry[]

  legalName                   String?
  logoUrl                     String?
  purchaseOrderActivityEvents PurchaseOrderActivityEvent[]

  npwp                         String?
  taxEnabled                   Boolean                       @default(false)
  taxName                      String?
  taxPercentage                Decimal?                      @db.Decimal(5, 2)
  address                      String?
  phone                        String?
  // IANA name (e.g. "Asia/Jakarta"). Drives which calendar day/fiscal
  // period a journal entry posts into (business-date.ts) — was a single
  // global ACCOUNTING_TIMEZONE env var before; now per-org.
  timezone                     String                        @default("Asia/Jakarta")
  brands                       Brand[]
  categories                   Category[]
  customers                    Customer[]
  customerAddresses            CustomerAddress[]
  customerLocationPhotos       CustomerLocationPhoto[]
  events                       Event[]
  externalOrders               ExternalOrder[]
  integrationConnections       IntegrationConnection[]
  invoices                     Invoice[]
  locations                    Location[]
  modules                      OrganizationModule[]
  taxRates                     OrganizationTaxRate[]
  products                     Product[]
  sessions                     Session[]
  salesQuotations              SalesQuotation[]
  salesOrders                  SalesOrder[]
  deliveryOrders               DeliveryOrder[]
  routes                       Route[]
  teams                        Team[]
  purchaseOrders               PurchaseOrder[]
  salesQuotationActivityEvents SalesQuotationActivityEvent[]
  goodsReceipts                GoodsReceipt[]
  suppliers                    Supplier[]

  stocks             Stock[]
  users              User[]
  vehicles           Vehicle[]
  vehicleReminders   VehicleReminder[]
  bankAccounts       OrganizationBankAccount[]
  fixedAssets        FixedAsset[]
  mediaAssets        MediaAsset[]
  notifications      Notification[]
  stockImportBatches StockImportBatch[]
  productCostHistory ProductCostHistory[]
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  supplierPayments  SupplierPayment[]
  settingsAuditLogs SettingsAuditLog[]
  resetToken        String?            @unique
  resetTokenExpires DateTime?

  // Change-password email OTP flow — see AuthService.requestPasswordChange/
  // confirmPasswordChange. pendingPasswordHash holds the already-hashed new
  // password chosen at request time so confirmPasswordChange only needs the
  // OTP code, not the password again; otpAttempts caps brute-force guesses
  // against the (short, numeric) code before it's invalidated.
  changePasswordOtpHash     String?
  changePasswordOtpExpires  DateTime?
  changePasswordOtpAttempts Int       @default(0)
  pendingPasswordHash       String?

  role             Role           @default(USER)
  active           Boolean        @default(true)
  // Set when an admin removes the member from the org. Users can't be
  // hard-deleted (invoices, journals, routes… reference them), so removal
  // = inactive + hidden from member lists + seat freed. Re-inviting the
  // same email restores the account (AuthService.invite).
  removedAt        DateTime?
  organizationId   String
  createdAt        DateTime       @default(now())
  currentSessionId String?
  avatarUrl        String?
  displayName      String? // admin-set label for drivers; UI only, falls back to email
  teamId           String? // only meaningful for role=DRIVER; a team has at most one driver (TeamsService.assignDriver) and that driver works the team's routes
  team             Team?          @relation(fields: [teamId], references: [id])
  mediaAssets      MediaAsset[]
  events           Event[]
  payrolls         Payroll[]
  expenses         Expense[]
  journalEntries   JournalEntry[]

  invoices                    Invoice[]
  activityEvents              InvoiceActivityEvent[]
  purchaseOrderActivityEvents PurchaseOrderActivityEvent[]

  paymentsRecorded             Payment[]
  expensePaymentsRecorded      ExpensePayment[]
  fixedAssets                  FixedAsset[]
  fixedAssetPaymentsRecorded   FixedAssetPayment[]
  sessionNotes                 SessionNote[]
  reopenEvents                 SessionReopenEvent[]
  organization                 Organization                  @relation(fields: [organizationId], references: [id])
  salesQuotations              SalesQuotation[]
  salesOrders                  SalesOrder[]
  deliveryOrders               DeliveryOrder[]
  routesCreated                Route[]                       @relation("RouteCreatedBy")
  routeHistoryEvents           RouteHistoryEvent[]
  salesOrderActivityEvents     SalesOrderActivityEvent[]
  salesQuotationActivityEvents SalesQuotationActivityEvent[]
  goodsReceipts                GoodsReceipt[]

  notifications     Notification[]
  devices           Device[]               @relation("UserDevices")
  devicesApproved   Device[]               @relation("DeviceApprovedBy")
  accessSchedules   DriverAccessSchedule[]
  pushSubscriptions PushSubscription[]

  @@index([organizationId])
}

// Org-scoped library of every uploaded image. Consumers (Product.image,
// User.avatarUrl) store the returned `url` directly rather than a FK to
// this table — same "denormalized URL string" convention as
// Organization.logoUrl — so an asset stays in the library for reuse even
// after the product/user that picked it changes or clears its photo.
model MediaAsset {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id])

  filename     String // on-disk filename under uploads/media/
  originalName String? // original upload filename — searched/displayed in the library UI
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  url          String // /uploads/media/<filename>

  compressedAt DateTime? // set by the scheduled hard-recompression job; null = not yet run

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, originalName])
}

model Installation {
  id          String   @id @default("singleton")
  fingerprint String   @unique
  machineId   String?
  createdAt   DateTime @default(now())
}

model Location {
  id                String             @id @default(uuid())
  name              String
  createdAt         DateTime           @default(now())
  expenses          Expense[]
  journalEntryLines JournalEntryLine[]

  organizationId      String
  archivedAt          DateTime?
  address             String?
  phone               String?
  fromEvents          Event[]              @relation("FromLocation")
  toEvents            Event[]              @relation("ToLocation")
  invoices            Invoice[]
  invoiceItems        InvoiceItem[]
  organization        Organization         @relation(fields: [organizationId], references: [id])
  stocks              Stock[]
  salesQuotations     SalesQuotation[]
  salesQuotationItems SalesQuotationItem[]
  salesOrders         SalesOrder[]
  salesOrderItems     SalesOrderItem[]
  deliveryOrders      DeliveryOrder[]
  deliveryOrderItems  DeliveryOrderItem[]
  externalWarehouseId String? // Accurate ITEM.WAREHOUSEID, for stock-import mapping
  goodsReceipts       GoodsReceipt[]
  purchaseOrders      PurchaseOrder[]
  fixedAssets         FixedAsset[]

  @@unique([id, organizationId])
  @@unique([organizationId, name, externalWarehouseId])
}

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  npwp        String?
  notes       String?
  isActive    Boolean @default(true)

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW — Accurate GDB import support
  externalId String? // Accurate PERSONDATA.ID (PO.VENDORID) — stable match key, avoids name-collision issues

  @@unique([organizationId, npwp])
  @@unique([organizationId, externalId]) // NEW
  @@index([organizationId, name])
}

model SupplierPayment {
  id              String                   @id @default(uuid())
  organizationId  String
  purchaseOrderId String
  amount          Decimal                  @db.Decimal(12, 2)
  method          PaymentMethod            @default(TRANSFER)
  paidAt          DateTime                 @default(now())
  note            String?
  recordedById    String?
  createdAt       DateTime                 @default(now())
  bankAccountId   String?
  bankAccount     OrganizationBankAccount? @relation(fields: [bankAccountId], references: [id])
  organization    Organization             @relation(fields: [organizationId], references: [id])
  purchaseOrder   PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id])
  recordedBy      User?                    @relation(fields: [recordedById], references: [id])

  @@index([purchaseOrderId])
}

enum DocumentType {
  INVOICE
  SALES_QUOTATION
  SALES_ORDER
  DELIVERY_ORDER
  PURCHASE_ORDER
}

model DocumentSequence {
  id             String       @id @default(cuid())
  organizationId String
  documentType   DocumentType
  prefix         String
  lastNumber     Int
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, documentType])
}

// Atomic, year-scoped counters backing DocumentNumberingService.nextSequential —
// replaces the old "count rows since Jan 1" + format pattern (nextInvoiceNumber
// and its counterparts), which raced under concurrent issuance and produced
// wrong sequences across a Dec 31 -> Jan 1 boundary if `count` was read with
// the old year already rolled over. documentType is a free-form key (e.g.
// "INVOICE", "GOODS_RECEIPT") rather than the DocumentType enum above, since
// not every numbered document (GoodsReceipt) has an enum member there.
model DocumentCounter {
  id             String   @id @default(cuid())
  organizationId String
  documentType   String
  year           Int
  lastNumber     Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, documentType, year])
}

model Category {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@unique([organizationId, name])
}

model Brand {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@unique([organizationId, name])
}

model Product {
  id                  String               @id @default(uuid())
  name                String
  createdAt           DateTime             @default(now())
  categoryId          String
  active              Boolean              @default(true)
  brandId             String?
  sku                 String?
  oem                 String?
  organizationId      String
  unit                String? // NEW — default unit of measure (pcs, box, ltr, kg, etc.); line items may override via their own `unit`
  image               String? // URL of a MediaAsset chosen via the media library; denormalized like Organization.logoUrl, not a FK
  salesQuotationItems SalesQuotationItem[]
  salesOrderItems     SalesOrderItem[]
  deliveryOrderItems  DeliveryOrderItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceiptItems   GoodsReceiptItem[]

  barcode            String?
  // Current weighted-average cost of the stock on hand. Moved only by
  // inventory-costing.ts (goods receipts, returns, opening imports) or a
  // logged manual edit; sales book COGS at whatever it is when stock leaves.
  costPrice          Decimal?                 @db.Decimal(12, 2)
  sellingPrice       Decimal?                 @db.Decimal(12, 2)
  events             Event[]
  externalOrderItems ExternalOrderItem[]
  externalMappings   ExternalProductMapping[]
  invoiceItems       InvoiceItem[]
  brand              Brand?                   @relation(fields: [brandId], references: [id])
  category           Category                 @relation(fields: [categoryId], references: [id])
  organization       Organization             @relation(fields: [organizationId], references: [id])
  sessionItems       SessionItem[]
  stocks             Stock[]
  // Prices for the non-default price levels. The default level's price is
  // sellingPrice above (kept there so imports, reports and older code
  // keep working unchanged).
  prices             ProductPrice[]
  // Every change to costPrice (the current weighted-average cost) and
  // what caused it — see inventory-costing.ts.
  costHistory        ProductCostHistory[]

  @@unique([organizationId, barcode])
  @@unique([organizationId, sku])
}

model Stock {
  id             Int          @id @default(autoincrement())
  productId      String
  locationId     String
  quantity       Decimal      @default(0) @db.Decimal(12, 2) // FIX — was Int; SalesOrderItem/DeliveryOrderItem quantities are Decimal, so a fractional delivery would fail here at ship time
  organizationId String
  location       Location     @relation(fields: [locationId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  @@unique([productId, locationId], name: "productId_locationId")
  @@index([organizationId])
  @@index([locationId])
}

model Session {
  id              String               @id @default(cuid())
  status          String               @default("OPEN")
  createdAt       DateTime             @default(now())
  completedAt     DateTime?
  organizationId  String
  type            SessionType
  stage           EventType?
  events          Event[]
  externalOrder   ExternalOrder?
  invoiceId       String?              @unique // unchanged — still exactly one session per invoice
  salesOrderId    String? // NOT unique — an SO can have many sessions over time
  invoice         Invoice?             @relation(fields: [invoiceId], references: [id])
  salesOrder      SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  deliveryOrders  DeliveryOrder[] // reverse of DeliveryOrder.sessionId
  organization    Organization         @relation(fields: [organizationId], references: [id])
  items           SessionItem[]
  notes           SessionNote[]
  reopenEvents    SessionReopenEvent[]
  // RECEIVE: the stock import this session is counting against
  // (import-first receiving — arriving goods have no barcodes until the
  // import has created them and labels are printed).
  importBatchId   String?
  importBatch     StockImportBatch?    @relation(fields: [importBatchId], references: [id])
  // RETURNS: the sale being returned. Not @unique like invoiceId — an
  // invoice can have several return sessions over time.
  returnInvoiceId String?
  returnInvoice   Invoice?             @relation("SessionReturnInvoice", fields: [returnInvoiceId], references: [id])

  @@index([organizationId, createdAt])
  @@index([returnInvoiceId])
  @@index([importBatchId])
}

model SessionItem {
  id        Int     @id @default(autoincrement())
  sessionId String
  productId String
  quantity  Decimal @db.Decimal(12, 2)
  events    Event[]
  product   Product @relation(fields: [productId], references: [id])
  session   Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model Event {
  id             Int               @id @default(autoincrement())
  fromLocationId String?
  toLocationId   String?
  quantity       Decimal           @db.Decimal(12, 2) // FIX — was Int; stockService.increase/decrease/fulfill write the same qty to Stock (now Decimal) and here in one call, so this must match
  createdAt      DateTime          @default(now())
  productId      String
  type           EventType
  metadata       Json?
  sessionId      String?
  sessionItemId  Int?
  organizationId String
  userId         String?
  invoiceId      String?
  salesOrderId   String?
  // queried/joined the same way invoice-driven ones already are,
  // instead of being buried inside `metadata`.
  balanceAfter   Decimal?          @db.Decimal(12, 2) // resulting Stock.quantity after this movement; null on rows written before this field existed
  oversold       Boolean           @default(false) // true when this movement (a SALE under WARN/ALLOW policy) pushed balanceAfter below zero
  fromLocation   Location?         @relation("FromLocation", fields: [fromLocationId], references: [id])
  invoice        Invoice?          @relation(fields: [invoiceId], references: [id])
  salesOrder     SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  product        Product           @relation(fields: [productId], references: [id])
  session        Session?          @relation(fields: [sessionId], references: [id])
  sessionItem    SessionItem?      @relation(fields: [sessionItemId], references: [id])
  toLocation     Location?         @relation("ToLocation", fields: [toLocationId], references: [id])
  user           User?             @relation(fields: [userId], references: [id])
  importBatchId  String?
  importBatch    StockImportBatch? @relation(fields: [importBatchId], references: [id])

  @@index([invoiceId])
  @@index([salesOrderId])
  @@index([organizationId, oversold])
  @@index([sessionId, productId, type])
  @@index([organizationId, createdAt])
  @@index([productId, createdAt])
  @@index([importBatchId])
}

model License {
  id           String    @id @default(uuid())
  key          String    @unique
  customerName String
  branchName   String
  domain       String?
  status       String    @default("ACTIVE")
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime?
  lastCheckIn  DateTime?
}

model SessionReopenEvent {
  id        Int      @id @default(autoincrement())
  sessionId String
  reason    String
  userId    String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model SessionNote {
  id        String   @id @default(cuid())
  sessionId String
  note      String
  userId    String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model IntegrationConnection {
  id                      String                   @id @default(uuid())
  organizationId          String
  provider                String
  columnMapping           Json?
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  externalOrders          ExternalOrder[]
  externalProductMappings ExternalProductMapping[]
  organization            Organization             @relation(fields: [organizationId], references: [id])
}

model ExternalProductMapping {
  id           String                @id @default(uuid())
  connectionId String
  productId    String
  externalSku  String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id])
  product      Product               @relation(fields: [productId], references: [id])

  @@unique([connectionId, externalSku])
}

model ExternalOrder {
  id             String                @id @default(uuid())
  organizationId String
  connectionId   String
  externalRef    String
  customerName   String?
  status         ExternalOrderStatus   @default(PENDING)
  sessionId      String?               @unique
  createdAt      DateTime              @default(now())
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id])
  organization   Organization          @relation(fields: [organizationId], references: [id])
  session        Session?              @relation(fields: [sessionId], references: [id])
  items          ExternalOrderItem[]

  @@unique([connectionId, externalRef])
}

model ExternalOrderItem {
  id              Int           @id @default(autoincrement())
  externalOrderId String
  externalSku     String
  quantity        Decimal       @db.Decimal(12, 2)
  productId       String?
  externalOrder   ExternalOrder @relation(fields: [externalOrderId], references: [id])
  product         Product?      @relation(fields: [productId], references: [id])
}

model OrganizationModule {
  id             String       @id @default(uuid())
  organizationId String
  module         ModuleKey
  enabled        Boolean      @default(true)
  activatedAt    DateTime     @default(now())
  expiresAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, module])
}

enum InvoiceActivityEventType {
  CREATED
  ISSUED
  EDITED
  PAYMENT_RECORDED
  MARKED_PAID
  VOIDED
  COST_CORRECTED
  REFUNDED
  CREDIT_APPLIED
}

enum SalesQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  CONVERTED // a SalesOrder has been created from this quotation
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  FULLY_DELIVERED
  CANCELLED
}

enum DeliveryOrderStatus {
  PACKED // created from a completed pack session, not yet shipped
  SHIPPED
  FAILED // NEW — delivery attempted but did not reach the customer; terminal like CANCELLED, set from SHIPPED via recordFailedDelivery()
  CANCELLED
  PARTIALLY_RETURNED // some but not all shipped items have come back
  RETURNED // every shipped item has come back
}

// ---- Sales Quotation ---------------------------------------------------
// No stock or financial commitment. Pure priced-lines-with-an-expiry.
// Converts into a SalesOrder by copying its lines forward — conversion is
// an explicit action, not a status side effect, so a quotation can be
// re-sent/re-priced without ever becoming CONVERTED.

model SalesQuotation {
  id               String                        @id @default(uuid())
  quotationNumber  String?
  organizationId   String
  locationId       String?
  status           SalesQuotationStatus          @default(DRAFT)
  invoices         Invoice[]
  sentAt           DateTime?
  activityEvents   SalesQuotationActivityEvent[]
  format           QuotationFormat               @default(A4)
  quotationDate    DateTime?                     @db.Date
  customerId       String?
  customerName     String?
  customerPoNumber String?

  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  validUntil         DateTime? @db.Date
  createdAt          DateTime  @default(now())
  userId             String?
  termsAndConditions String?
  notes              String?

  // NEW — same bank-account snapshot as Invoice, above.
  bankAccountId     String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  bankAccount       OrganizationBankAccount? @relation(fields: [bankAccountId], references: [id])

  organization Organization         @relation(fields: [organizationId], references: [id])
  customer     Customer?            @relation(fields: [customerId, organizationId], references: [id, organizationId])
  location     Location?            @relation(fields: [locationId, organizationId], references: [id, organizationId])
  user         User?                @relation(fields: [userId], references: [id])
  items        SalesQuotationItem[]
  taxes        SalesQuotationTax[]
  salesOrders  SalesOrder[]

  @@unique([organizationId, quotationNumber])
}

model SalesQuotationItem {
  id               String  @id @default(uuid())
  salesQuotationId String
  productId        String?
  description      String?
  locationId       String?
  unit             String?

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2) // gross: quantity × unitPrice, unchanged meaning

  // NEW — per-item discount, same shape as InvoiceItem below
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  netAmount      Decimal       @default(0) @db.Decimal(12, 2) // lineTotal - discountAmount; tax is now computed on this, not lineTotal

  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2) // netAmount + taxAmount — kept for internal/back-compat use; the A4 table's printed "Total" column uses netAmount instead, see template notes below

  salesQuotation SalesQuotation          @relation(fields: [salesQuotationId], references: [id])
  product        Product?                @relation(fields: [productId], references: [id])
  location       Location?               @relation(fields: [locationId], references: [id])
  taxes          SalesQuotationItemTax[]

  // Where unitPrice came from. unitPrice itself is the historical price
  // charged and never follows later price-level edits. Null = custom price
  // (POS pricing) or a line created before price levels existed.
  priceLevelId String?
  priceLevel   PriceLevel? @relation(fields: [priceLevelId], references: [id])
}

model SalesQuotationTax {
  id               String               @id @default(uuid())
  salesQuotationId String
  taxRateId        String?
  name             String
  percentage       Decimal              @db.Decimal(5, 2)
  amount           Decimal              @db.Decimal(12, 2)
  taxRate          OrganizationTaxRate? @relation(fields: [taxRateId], references: [id])

  salesQuotation SalesQuotation @relation(fields: [salesQuotationId], references: [id])
}

model SalesQuotationItemTax {
  id                   String               @id @default(uuid())
  salesQuotationItemId String
  taxRateId            String?
  name                 String
  percentage           Decimal              @db.Decimal(5, 2)
  amount               Decimal              @db.Decimal(12, 2)
  taxRate              OrganizationTaxRate? @relation(fields: [taxRateId], references: [id])

  salesQuotationItem SalesQuotationItem @relation(fields: [salesQuotationItemId], references: [id])
}

// ---- Sales Order ---------------------------------------------------------
// The confirmed commitment. status is DERIVED from summing DeliveryOrderItem
// quantities against each SalesOrderItem — recompute-and-write inside the
// same transaction that creates/edits a DeliveryOrder, same reasoning as
// Invoice.paymentStatus. Never hand-set PARTIALLY_DELIVERED/FULLY_DELIVERED
// from outside that transaction.

model SalesOrder {
  id             String           @id @default(uuid())
  orderNumber    String?
  organizationId String
  locationId     String?
  status         SalesOrderStatus @default(DRAFT)
  confirmedAt    DateTime?
  format         SalesOrderFormat @default(A4)

  quotationId      String? // nullable — SO can be created without a prior quotation
  customerId       String?
  customerName     String?
  customerPoNumber String? // NEW — customer's own reference/PO number
  vehicleId        String?

  subtotal   Decimal   @default(0) @db.Decimal(12, 2)
  discount   Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount  Decimal   @default(0) @db.Decimal(12, 2)
  total      Decimal   @default(0) @db.Decimal(12, 2)
  orderDate  DateTime? @db.Date
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  userId     String?
  approvedBy String? // NEW — name/role of internal approver (free text, not a User FK, since approval may be by someone outside the system)
  notes      String? // NEW

  organization   Organization              @relation(fields: [organizationId], references: [id])
  quotation      SalesQuotation?           @relation(fields: [quotationId], references: [id])
  customer       Customer?                 @relation(fields: [customerId, organizationId], references: [id, organizationId])
  location       Location?                 @relation(fields: [locationId, organizationId], references: [id, organizationId])
  vehicle        Vehicle?                  @relation(fields: [vehicleId, organizationId], references: [id, organizationId])
  user           User?                     @relation(fields: [userId], references: [id])
  items          SalesOrderItem[]
  taxes          SalesOrderTax[]
  invoices       Invoice[] // header-level convenience FK, see Invoice changes below
  deliveryOrders DeliveryOrder[] // header-level convenience FK, line linkage is the source of truth
  sessions       Session[] // an SO can have MULTIPLE sessions over its life — one per pack/ship batch
  activityEvents SalesOrderActivityEvent[]
  events         Event[] // inverse of Event.salesOrderId, enables salesOrder.events

  @@unique([organizationId, orderNumber])
}

model SalesOrderItem {
  id           String  @id @default(uuid())
  salesOrderId String
  productId    String?
  description  String?
  locationId   String?
  unit         String?

  quantity  Decimal  @db.Decimal(12, 2)
  unitPrice Decimal  @db.Decimal(12, 2)
  unitCost  Decimal? @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)

  // NEW — per-item discount
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  netAmount      Decimal       @default(0) @db.Decimal(12, 2)

  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  deliveredQuantity Decimal @default(0) @db.Decimal(12, 2)

  salesOrder         SalesOrder          @relation(fields: [salesOrderId], references: [id])
  product            Product?            @relation(fields: [productId], references: [id])
  location           Location?           @relation(fields: [locationId], references: [id])
  taxes              SalesOrderItemTax[]
  deliveryOrderItems DeliveryOrderItem[]
  invoiceItems       InvoiceItem[]

  // Where unitPrice came from (see SalesQuotationItem.priceLevelId).
  priceLevelId String?
  priceLevel   PriceLevel? @relation(fields: [priceLevelId], references: [id])
}

model SalesOrderTax {
  id           String               @id @default(uuid())
  salesOrderId String
  taxRateId    String?
  name         String
  percentage   Decimal              @db.Decimal(5, 2)
  amount       Decimal              @db.Decimal(12, 2)
  taxRate      OrganizationTaxRate? @relation(fields: [taxRateId], references: [id])

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model SalesOrderItemTax {
  id               String               @id @default(uuid())
  salesOrderItemId String
  taxRateId        String?
  name             String
  percentage       Decimal              @db.Decimal(5, 2)
  amount           Decimal              @db.Decimal(12, 2)
  taxRate          OrganizationTaxRate? @relation(fields: [taxRateId], references: [id])

  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
}

// Same activity-feed pattern as InvoiceActivityEvent — kept as its own
// table rather than merged into that one, since the two documents have
// different eventType vocabularies (CONFIRMED, PARTIALLY_DELIVERED, etc.)
// If you'd rather have one polymorphic feed across all document types,
// that's a bigger schema change than this rebuild needs right now.
model SalesOrderActivityEvent {
  id             String     @id @default(uuid())
  salesOrderId   String
  organizationId String
  userId         String
  eventType      String
  reason         String?
  createdAt      DateTime   @default(now())
  metadata       Json?
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id])
  user           User       @relation(fields: [userId], references: [id])
}

// ---- Delivery Order --------------------------------------------------
// Thin and derived — no pricing, no direct stock calls. Represents what
// was actually packed in ONE shipment; a SalesOrder can have many. Stock
// already moved at pick time inside the linked Session; DeliveryOrder is
// the printable record of that, not a stock-moving event itself.
//
// customerId/customerName/deliveryAddress are denormalized snapshots off
// the parent SalesOrder at creation time — same rationale as
// DeliveryOrderItem.productName: a DO is a printed, signed proof-of-
// delivery record, so it shouldn't silently change if the customer's
// address is edited later. Populate them from SalesOrder.customer at
// DeliveryOrder-creation time rather than joining through at print time.

model DeliveryOrder {
  id             String              @id @default(uuid())
  doNumber       String?
  organizationId String
  sessionId      String? // the pack session this was generated from
  locationId     String?
  status         DeliveryOrderStatus @default(PACKED)
  createdAt      DateTime            @default(now())
  userId         String?
  shippedAt      DateTime? // NEW — set when ship() transitions PACKED -> SHIPPED; this is the real "Delivery Date"
  customerPhone  String? // NEW — same snapshot rationale as customerAddress; captured at creation so a later edit to the customer record can't rewrite a signed DO

  customerId       String? // denormalized from SalesOrder.customerId at creation time
  customerName     String? // denormalized snapshot, same convention as Invoice.customerName
  customerAddress  String? // NEW — customer's address of record, snapshotted (distinct from deliveryAddress below)
  customerPoNumber String? // NEW — customer's own reference/PO number
  deliveryAddress  String? // where THIS shipment was actually sent — may differ from customerAddress (job site, branch, third party)
  deliveredBy      String? // name of the driver/staff who handed off the shipment (free text, not a User FK — may be a third-party courier)
  receivedBy       String? // name of the person who signed for/received the shipment at the customer's end
  signedAt         DateTime? // NEW — timestamp of receipt confirmation; pair with receivedBy as the minimal proof-of-delivery record
  notes            String?

  // NEW — single-shot GPS capture, not continuous tracking. Set once by
  // recordProofOfDelivery()/recordFailedDelivery() from navigator.geolocation
  // at the moment the driver taps the button; never updated afterward and
  // never polled. Decimal(9,6) gives ~11cm precision, standard for lat/lng.
  completedLatitude  Decimal?  @db.Decimal(9, 6)
  completedLongitude Decimal?  @db.Decimal(9, 6)
  // Reported accuracy radius (metres) of that GPS fix, from
  // GeolocationCoordinates.accuracy — null when the device gave none.
  // signedAt is the capture time. Drives whether the fix is good enough
  // to become the customer's first pin (see customer-pin-backfill.ts).
  completedAccuracy  Float?
  failedAt           DateTime?
  failureReason      String?
  failureLatitude    Decimal?  @db.Decimal(9, 6)
  failureLongitude   Decimal?  @db.Decimal(9, 6)

  // NEW — the delivery destination pin, set by clicking a point on a map
  // (no geocoding service exists). Planning data, correctable any time —
  // unlike completed/failureLatitude above, this isn't a one-shot event
  // capture. Per-DeliveryOrder rather than per-Customer because
  // deliveryAddress (above) can already differ from the customer's own
  // address (job site, branch, third party); a per-shipment pin follows
  // that same reasoning.
  destinationLatitude  Decimal? @db.Decimal(9, 6)
  destinationLongitude Decimal? @db.Decimal(9, 6)

  // NEW — priority-weighted routing input (DeliveryRoutesService.optimize()
  // visits HIGH stops first, as their own optimized sub-sequence).
  priority DeliveryPriority @default(NORMAL)

  // NEW — this specific shipment's requested window, a concrete datetime
  // (not a recurring daily "HH:mm") since a DeliveryOrder is one shipment
  // on one day, not a recurring booking. Feeds into RouteStop's derived
  // atRisk alongside plannedEta.
  deliveryWindowStart DateTime?
  deliveryWindowEnd   DateTime?

  // LEGACY — proofs recorded before proofPhotoKey existed were uploaded
  // through the media library (POST /media) and referenced here as a
  // plain public URL. No longer written; still read for old deliveries.
  // MediaService refuses to delete or recompress assets referenced here.
  proofPhotoUrl String?
  // Private delivery-proof photo, as a FileStorage key
  // ("delivery-proofs/<orgId>/<doId>/<uuid>.webp") — never a public URL.
  // Uploaded via POST /delivery-orders/:id/proof-photo and viewed through a
  // short-lived signed link. Kept apart from the media library: no
  // recompression, not deletable from the gallery. proofPhotoUrl above is
  // the legacy field from when proofs went through the media library.
  proofPhotoKey String?

  // NEW — set by rescheduleDelivery() when a FAILED delivery is put back
  // into SHIPPED status for re-attempt. failedAt/failureReason are kept
  // as history rather than cleared.
  rescheduledAt DateTime?

  organization     Organization        @relation(fields: [organizationId], references: [id])
  salesOrderId     String? // CHANGED: was required — now optional
  salesOrder       SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  session          Session?            @relation(fields: [sessionId], references: [id])
  location         Location?           @relation(fields: [locationId], references: [id])
  user             User?               @relation(fields: [userId], references: [id])
  customer         Customer?           @relation(fields: [customerId, organizationId], references: [id, organizationId])
  items            DeliveryOrderItem[]
  invoiceId        String? // NEW
  invoice          Invoice?            @relation(fields: [invoiceId], references: [id])
  // The DO's current (live) stop, if it's on a route — most DOs aren't.
  // Relation runs through RouteStop.activeDeliveryOrderId, so a stop
  // superseded by rescheduleDelivery() drops out of this and the DO can go
  // onto a new route. routeStopHistory is every stop it has ever had.
  routeStop        RouteStop?          @relation("ActiveRouteStop")
  routeStopHistory RouteStop[]         @relation("RouteStopDeliveryOrder")

  @@unique([organizationId, doNumber])
  @@index([invoiceId])
}

model DeliveryOrderItem {
  id               String   @id @default(uuid())
  deliveryOrderId  String
  returnedQuantity Decimal  @default(0) @db.Decimal(12, 2)
  unitCost         Decimal? @db.Decimal(12, 2)

  // Denormalized snapshot for print stability (matches how InvoiceItem
  // stores description directly rather than always joining to Product) —
  // a renamed/discontinued product shouldn't rewrite historical DOs.
  productId   String?
  productName String
  quantity    Decimal @db.Decimal(12, 2)
  unit        String? // NEW — pcs, box, ltr, etc.; falls back to Product.unit when null
  locationId  String?

  deliveryOrder    DeliveryOrder   @relation(fields: [deliveryOrderId], references: [id])
  salesOrderItemId String? // CHANGED: was required — now optional
  salesOrderItem   SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])
  product          Product?        @relation(fields: [productId], references: [id])
  location         Location?       @relation(fields: [locationId], references: [id])

  invoiceItemId Int?         @unique
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
}

// A team's planned multi-stop delivery run for one day. Belongs to the
// DELIVERY_DMS module — separate from DeliveryOrder (a single-shipment
// document, ungated) which Route can wrap via RouteStop.
model Route {
  id              String      @id @default(cuid())
  organizationId  String
  // Routes belong to a team, not a driver: whoever is the team's driver
  // (one per team) works it. One non-cancelled route per team per day.
  teamId          String
  routeDate       DateTime
  name            String?
  status          RouteStatus @default(PLANNED)
  createdByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // NEW — depot/starting point pin, same click-to-pin UX as
  // DeliveryOrder.destinationLatitude. Required before optimize() can run.
  startLatitude      Decimal?  @db.Decimal(9, 6)
  startLongitude     Decimal?  @db.Decimal(9, 6)
  plannedDepartureAt DateTime?
  // Bumped on every change to the stop list/order (see
  // DeliveryRoutesService.recordHistory); each such history event stores
  // the version it produced plus a snapshot of the stop order.
  version            Int       @default(1)

  organization  Organization        @relation(fields: [organizationId], references: [id])
  team          Team                @relation(fields: [teamId], references: [id])
  createdBy     User?               @relation("RouteCreatedBy", fields: [createdByUserId], references: [id])
  stops         RouteStop[]
  historyEvents RouteHistoryEvent[]

  @@index([organizationId])
  @@index([organizationId, teamId, routeDate])
}

// A stop is either a DeliveryOrder (required when the org has INVOICE_POS)
// or a customer visit (orgs without INVOICE_POS). DO stops have no state
// of their own — pending/delivered/failed is derived from the DO, which
// stays the source of truth. Customer stops carry their own pin, proof and
// failure fields below (the "customer stop" block); those are null on DO
// stops. Exactly one of deliveryOrderId / customerId is set (CHECK in SQL).
model RouteStop {
  id                    String    @id @default(cuid())
  routeId               String
  deliveryOrderId       String? // every DO stop, live or superseded
  // = deliveryOrderId while this stop is live, NULL once superseded. The
  // unique index on it (NULLs are distinct in Postgres) is what enforces
  // "a DO has at most one live stop" while still letting a rescheduled
  // DO's failed stop stay on its original route as history.
  activeDeliveryOrderId String?   @unique
  // Set by rescheduleDelivery(): this stop's attempt failed and the DO was
  // put back into SHIPPED for a new attempt elsewhere. A superseded stop
  // always presents as FAILED, whatever the DO's current status.
  supersededAt          DateTime?
  // Set once the at-risk cron has alerted dispatch about this stop, so a
  // slipping stop produces one notification, not one per cron tick.
  atRiskNotifiedAt      DateTime?
  lateNotifiedAt        DateTime? // DELIVERY_LATE sent — separate from at-risk, a stop can get both
  sequence              Int // 1-based order within the route
  plannedEta            DateTime? // computed by DeliveryRoutesService.optimize()/recalculateEtasAfterResolution()
  createdAt             DateTime  @default(now())

  // NEW — cached leg data from the last optimize() call, from this stop's
  // previous stop (or the route's start point for the first pending stop).
  // Lets ETA recalculation after a delivery resolves be pure arithmetic —
  // no repeat OSRM calls at delivery-time.
  travelMetersFromPrevious  Decimal? @db.Decimal(10, 2)
  travelSecondsFromPrevious Int?

  // ── Customer stop ──
  // Name/address/pin are snapshotted from the Customer when the stop is
  // added. The pin may be corrected on the stop while the route is open;
  // that never writes back to the Customer, so the change lasts only for
  // this route.
  customerId           String?
  customerName         String?
  address              String?
  destinationLatitude  Decimal?         @db.Decimal(9, 6)
  destinationLongitude Decimal?         @db.Decimal(9, 6)
  priority             DeliveryPriority @default(NORMAL)
  deliveryWindowStart  DateTime?
  deliveryWindowEnd    DateTime?
  // Proof (receiver + photo required) — same meaning as the DO fields.
  receivedBy           String?
  signedAt             DateTime?
  proofPhotoKey        String? // "stop-proofs/<orgId>/<stopId>/<uuid>.webp", private
  completedByUserId    String?
  completedLatitude    Decimal?         @db.Decimal(9, 6)
  completedLongitude   Decimal?         @db.Decimal(9, 6)
  completedAccuracy    Float? // metres — same meaning as the DO field
  failedAt             DateTime?
  failureReason        String?
  failureLatitude      Decimal?         @db.Decimal(9, 6)
  failureLongitude     Decimal?         @db.Decimal(9, 6)

  route               Route          @relation(fields: [routeId], references: [id])
  deliveryOrder       DeliveryOrder? @relation("RouteStopDeliveryOrder", fields: [deliveryOrderId], references: [id], onDelete: Restrict)
  customer            Customer?      @relation(fields: [customerId], references: [id])
  activeDeliveryOrder DeliveryOrder? @relation("ActiveRouteStop", fields: [activeDeliveryOrderId], references: [id])

  @@unique([routeId, sequence])
  @@index([routeId])
  @@index([deliveryOrderId])
  @@index([customerId])
}

// The unit routes are planned for: one team = one driver = one route per
// day. The driver joins the team (User.teamId); the team owns the routes,
// so swapping the driver doesn't orphan planned work. The team's working
// hours are its driver's DriverAccessSchedule.
model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  members      User[]
  routes       Route[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum RouteHistoryEventType {
  CREATED
  DRIVER_CHANGED
  START_SET
  STOP_ADDED
  STOP_REMOVED
  STOPS_REORDERED
  OPTIMIZED
  STATUS_CHANGED
  STOP_RESCHEDULED
}

// Append-only audit trail of route changes — spec's "route version, time
// changed, who changed it, stop sequence" requirement. Written best-effort
// by DeliveryRoutesService alongside each mutation; never blocks the
// mutation itself if a write here fails (same pattern as ETA recalc).
model RouteHistoryEvent {
  id              String                @id @default(cuid())
  routeId         String
  type            RouteHistoryEventType
  createdAt       DateTime              @default(now())
  createdByUserId String?
  metadata        Json?

  route     Route @relation(fields: [routeId], references: [id])
  createdBy User? @relation(fields: [createdByUserId], references: [id])

  @@index([routeId, createdAt])
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

model OrganizationBankAccount {
  id                 String              @id @default(uuid())
  organizationId     String
  bankName           String
  accountNumber      String
  accountName        String
  chartAccount       ChartOfAccount? // inverse of the relation above
  payments           Payment[] // NEW
  expenses           Expense[] // NEW
  expensePayments    ExpensePayment[]
  supplierPayments   SupplierPayment[] // NEW (in addition to the relation already declared on SupplierPayment below)
  fixedAssetPayments FixedAssetPayment[]
  payrolls           Payroll[] // NEW

  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  archivedAt      DateTime?
  organization    Organization     @relation(fields: [organizationId], references: [id])
  invoices        Invoice[]
  salesQuotations SalesQuotation[]

  @@unique([organizationId, bankName, accountNumber])
  @@index([organizationId])
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

model Invoice {
  id                String            @id @default(uuid())
  invoiceNumber     String?
  organizationId    String
  deliveryOrders    DeliveryOrder[]
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  replacesInvoiceId String?           @unique
  replaces          Invoice?          @relation("InvoiceReplacement", fields: [replacesInvoiceId], references: [id])
  replacedBy        Invoice?          @relation("InvoiceReplacement")
  employeeId        String?
  employee          Employee?         @relation(fields: [employeeId], references: [id])
  fulfillmentPath   FulfillmentPath?

  locationId       String?
  format           InvoiceFormat
  status           InvoiceStatus @default(DRAFT)
  customerName     String?
  customerPoNumber String?
  subtotal         Decimal       @default(0) @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @default(0) @db.Decimal(12, 2)
  userId           String?
  createdAt        DateTime      @default(now())
  invoiceDate      DateTime?     @db.Date
  issuedAt         DateTime?
  customerId       String?
  amountPaid       Decimal       @default(0) @db.Decimal(12, 2) // was Int
  creditedAmount   Decimal       @default(0) @db.Decimal(12, 2) // FIX — sum of postSalesReturn's AR reversal; AR Aging subtracts this so a return doesn't leave the invoice looking overdue for units the customer no longer owes for

  paymentStatus PaymentStatus @default(UNPAID)
  paymentTerms  String?
  dueDate       DateTime?
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  vehicleId     String?
  salesOrderId  String?

  // NEW — bank account snapshot, same rationale as customerName /
  // DeliveryOrderItem.productName: a printed document shouldn't
  // silently change if the account is edited or archived later.
  bankAccountId     String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  bankAccount       OrganizationBankAccount? @relation(fields: [bankAccountId], references: [id])

  notes          String?
  events         Event[]
  customer       Customer?              @relation(fields: [customerId, organizationId], references: [id, organizationId])
  location       Location?              @relation(fields: [locationId, organizationId], references: [id, organizationId])
  organization   Organization           @relation(fields: [organizationId], references: [id])
  user           User?                  @relation(fields: [userId], references: [id])
  vehicle        Vehicle?               @relation(fields: [vehicleId, organizationId], references: [id, organizationId])
  salesOrder     SalesOrder?            @relation(fields: [salesOrderId], references: [id])
  activityEvents InvoiceActivityEvent[]
  items          InvoiceItem[]
  taxes          InvoiceTax[]
  payments       Payment[]
  session        Session?
  quotationId    String?
  quotation      SalesQuotation?        @relation(fields: [quotationId], references: [id])
  odometer       Int?
  nextServiceKm  Int?

  // FIX — vehicle/customer identity snapshot, same rationale as
  // bankAccountName above: a printed invoice shouldn't silently change
  // its plate/VIN/customer details because the Vehicle/Customer record
  // was edited or corrected later. Populated once, at issue() time, and
  // preferred over the live vehicle/customer relation when present; a
  // null here (drafts, and invoices issued before this column existed)
  // still falls back to the live join.
  vehiclePlateNumber     String?
  vehicleModel           String?
  vehicleVin             String?
  customerAddress        String?
  customerBillingAddress String?
  customerPhone          String?
  customerNpwp           String?

  discountType   DiscountType?
  discountValue  Decimal?
  returnSessions Session[]     @relation("SessionReturnInvoice")

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, employeeId]) // NEW
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

enum PurchaseOrderActivityEventType {
  CREATED
  EDITED
  SENT
  CANCELLED
}

model PurchaseOrder {
  id               String                       @id @default(uuid())
  poNumber         String?
  supplierPayments SupplierPayment[]
  organizationId   String
  locationId       String?
  status           PurchaseOrderStatus          @default(DRAFT)
  supplierId       String?
  subtotal         Decimal                      @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal                      @default(0) @db.Decimal(12, 2)
  total            Decimal                      @default(0) @db.Decimal(12, 2)
  createdAt        DateTime                     @default(now())
  userId           String?
  goodsReceipts    GoodsReceipt[]
  organization     Organization                 @relation(fields: [organizationId], references: [id])
  items            PurchaseOrderItem[]
  discountAmount   Decimal                      @default(0) @db.Decimal(12, 2)
  taxRateId        String?
  notes            String?
  expectedDate     DateTime?                    @db.Date
  supplier         Supplier?                    @relation(fields: [supplierId], references: [id])
  taxRate          OrganizationTaxRate?         @relation(fields: [taxRateId], references: [id])
  location         Location?                    @relation(fields: [locationId], references: [id])
  activityEvents   PurchaseOrderActivityEvent[]
  dueDate          DateTime?
  paymentTerms     String?
  // NEW — Accurate GDB import support
  externalId       String? // Accurate PO.POID — stable idempotency key, independent of poNumber
  orderDate        DateTime?                    @db.Date // Accurate PODATE

  @@unique([organizationId, poNumber])
  @@unique([organizationId, externalId]) // NEW
}

model PurchaseOrderItem {
  id                String             @id @default(uuid())
  purchaseOrderId   String
  productId         String?
  quantity          Decimal            @db.Decimal(12, 2)
  unitCost          Decimal            @db.Decimal(12, 2)
  lineTotal         Decimal            @db.Decimal(12, 2)
  description       String?
  goodsReceiptItems GoodsReceiptItem[]

  // REMOVED — dead field, never read by GoodsReceiptService. Superseded by
  // importedReceivedQuantity below, which the service actually consumes.
  // receivedQuantity Decimal @default(0) @db.Decimal(12, 2)

  // NEW — Accurate GDB import support
  unit                     String? // Accurate PODET.ITEMUNIT
  unitRatio                Decimal? @db.Decimal(12, 4) // Accurate PODET.UNITRATIO
  discountPercentage       Decimal? @db.Decimal(5, 2) // Accurate PODET.ITEMDISCPC (also applied into lineTotal at import time)
  importedReceivedQuantity Decimal  @default(0) @db.Decimal(12, 2) // Accurate PODET.QTYRECV — historical only, no real GoodsReceipt behind it; folded into GoodsReceiptService.receivedQuantitiesByPoItem
  externalSeq              Int? // Accurate PODET.SEQ — stable per-line key within one PO, for idempotent re-import

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product?      @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, externalSeq]) // NEW — nullable externalSeq is fine, Postgres allows many NULLs in a unique index
}

model PurchaseOrderActivityEvent {
  id              String                         @id @default(cuid())
  purchaseOrderId String?
  poNumber        String?
  organizationId  String
  userId          String
  eventType       PurchaseOrderActivityEventType
  reason          String?
  metadata        Json?
  createdAt       DateTime                       @default(now())

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  organization  Organization   @relation(fields: [organizationId], references: [id])
  user          User           @relation(fields: [userId], references: [id])

  @@index([organizationId, purchaseOrderId])
}

model GoodsReceipt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  receiptNumber String? // e.g. GR-000045, assigned via DocumentNumberingService
  notes         String?

  items GoodsReceiptItem[]

  createdAt DateTime @default(now())

  @@unique([organizationId, receiptNumber]) // FIX — matches the @@unique([organizationId, xNumber]) pattern every other document number follows; comment already claimed DocumentNumberingService assigns these, so they should never collide
  @@index([organizationId, purchaseOrderId])
}

model GoodsReceiptItem {
  id String @id @default(cuid())

  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(12, 2)

  @@index([purchaseOrderItemId])
}

model InvoiceActivityEvent {
  id             String                   @id @default(cuid())
  invoiceId      String
  organizationId String
  userId         String?
  eventType      InvoiceActivityEventType @default(EDITED) // default keeps every EXISTING row correctly classified as EDITED, since that's all this table ever recorded until now
  reason         String? // was required — now optional since PAYMENT_RECORDED/MARKED_PAID/CREATED/ISSUED don't have a user-typed reason
  oldTotal       Decimal?
  newTotal       Decimal?
  changes        Json? // was required — now optional; only EDITED populates this
  createdAt      DateTime                 @default(now())
  invoice        Invoice                  @relation(fields: [invoiceId], references: [id])
  user           User?                    @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@map("InvoiceEditEvent") // keeps the physical table name — this is a rename+extend, not a new table, so existing history rows survive untouched
}

model InvoiceItem {
  id                Int      @id @default(autoincrement())
  invoiceId         String
  productId         String?
  quantity          Decimal  @db.Decimal(12, 2)
  unit              String?
  unitPrice         Decimal  @db.Decimal(12, 2)
  unitCost          Decimal? @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(12, 2) // gross: quantity × unitPrice — UNCHANGED meaning, still pre-discount
  fulfilledQuantity Decimal  @default(0) @db.Decimal(12, 2)
  reservedQuantity  Decimal  @default(0) @db.Decimal(12, 2)
  costProvisional   Boolean  @default(false) // true when unitCost was booked while this line oversold stock; the line's COGS may need revisiting once real cost is known

  // NEW — per-item discount. Mirrors Invoice.discountType/discountValue
  // (now deprecated at the document level, see below) but scoped per line.
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  // NEW — lineTotal - discountAmount. This is what tax is now computed
  // against (previously tax was computed on the gross lineTotal), and
  // it's what the A4 item table's "Total" column prints (pre-tax,
  // post-discount — tax stays document-level in the printed table).
  netAmount      Decimal       @default(0) @db.Decimal(12, 2)

  taxAmount   Decimal @default(0) @db.Decimal(12, 2) // now computed on netAmount, not lineTotal
  total       Decimal @default(0) @db.Decimal(12, 2) // netAmount + taxAmount — internal/back-compat field, not the printed "Total"
  locationId  String?
  description String?

  // FIX — product identity snapshot, same rationale as
  // Invoice.vehiclePlateNumber: a printed invoice line shouldn't change
  // its product name/SKU because the product was renamed or deleted
  // later. Populated once, at issue() time.
  productName       String?
  sku               String?
  salesOrderItemId  String?
  invoice           Invoice            @relation(fields: [invoiceId], references: [id])
  location          Location?          @relation(fields: [locationId], references: [id])
  product           Product?           @relation(fields: [productId], references: [id])
  salesOrderItem    SalesOrderItem?    @relation(fields: [salesOrderItemId], references: [id])
  deliveryOrderItem DeliveryOrderItem? // back-relation only — FK lives on DeliveryOrderItem.invoiceItemId
  taxes             InvoiceItemTax[]

  // Where unitPrice came from (see SalesQuotationItem.priceLevelId).
  priceLevelId String?
  priceLevel   PriceLevel? @relation(fields: [priceLevelId], references: [id])
}

enum SalesQuotationActivityEventType {
  CREATED
  EDITED
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
  CONVERTED
  DISCARDED
}

model SalesQuotationActivityEvent {
