model InvoiceItemTax {
  id            String               @id @default(cuid())
  invoiceItemId Int
  taxRateId     String?
  name          String
  percentage    Decimal              @db.Decimal(5, 2)
  amount        Decimal              @db.Decimal(12, 2)
  invoiceItem   InvoiceItem          @relation(fields: [invoiceItemId], references: [id])
  taxRate       OrganizationTaxRate? @relation(fields: [taxRateId], references: [id])

  @@index([invoiceItemId])
}

model Payment {
  id        String  @id @default(cuid())
  invoiceId String
  amount    Decimal @db.Decimal(12, 2) // was Int

  method        PaymentMethod            @default(CASH)
  note          String?
  recordedById  String?
  createdAt     DateTime                 @default(now())
  invoice       Invoice                  @relation(fields: [invoiceId], references: [id])
  recordedBy    User?                    @relation(fields: [recordedById], references: [id])
  bankAccountId String?
  bankAccount   OrganizationBankAccount? @relation(fields: [bankAccountId], references: [id])

  // Voiding keeps the row (it used to be deleted) so the payment history
  // stays complete; voided payments are excluded everywhere amounts are
  // read. voidedById is a plain id, not a relation, to avoid a second
  // named Payment↔User relation alongside recordedBy.
  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  // What this row does to the invoice's amountPaid (amount itself is always
  // positive): PAYMENT and CREDIT_IN add, REFUND and CREDIT_OUT subtract.
  // A credit application is a CREDIT_OUT on the invoice holding the credit
  // plus a CREDIT_IN on the one it pays, linked to each other.
  kind            PaymentKind @default(PAYMENT)
  linkedPaymentId String?

  @@index([invoiceId])
}

enum PaymentKind {
  PAYMENT
  REFUND
  CREDIT_OUT
  CREDIT_IN
}

enum FulfillmentMode {
  PICK_PACK_SHIP
  PICK_SHIP
}

// Per-tenant POS stock enforcement. BLOCK caps a sale's fulfilled quantity at
// what's available (today's behavior, unchanged). WARN also caps it unless
// the client resubmits with confirmOversell, in which case it fulfills in
// full and goes negative. ALLOW always fulfills in full and goes negative,
// no confirmation needed.
enum StockPolicy {
  BLOCK
  WARN
  ALLOW
}

// Generic org-settings change log — reusable beyond stockPolicy. There was
// no cross-entity audit table before this; per-document activity is tracked
// on *ActivityEvent models instead, which don't fit a settings field change.
model SettingsAuditLog {
  id             String       @id @default(cuid())
  organizationId String
  field          String
  oldValue       String?
  newValue       String?
  userId         String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, field])
}

// Generic recipient-scoped notification, in-app + (optionally) push. Kept
// deliberately generic (typed `payload`/`link` rather than per-feature
// columns) so callers across modules — delivery, device approval, account
// lock/unlock — can all write into the same feed instead of each growing
// their own ad-hoc alert table.
model Notification {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  type           NotificationType
  title          String
  body           String?
  payload        Json?
  link           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, readAt])
  @@index([organizationId, createdAt])
}

enum NotificationType {
  DELIVERY_ASSIGNED
  ROUTE_REASSIGNED
  ROUTE_REOPTIMIZED
  DELIVERY_FAILED
  DELIVERY_AT_RISK
  DELIVERY_LATE
  ROUTE_STOPS_CHANGED
  DEVICE_PENDING_APPROVAL
  DEVICE_APPROVED
  DEVICE_REJECTED
  DEVICE_REVOKED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
}

// A browser/device a DRIVER has logged in from. `deviceId` is a
// client-generated UUID persisted in localStorage (see frontend apifetch),
// not this row's own id — it's how the same physical device is recognized
// across logins. First device for a driver auto-approves so onboarding
// isn't blocked; any later device starts PENDING and blocks login until an
// admin approves it (see AuthService.login).
model Device {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation("UserDevices", fields: [userId], references: [id])
  deviceId         String
  label            String?
  userAgent        String?
  status           DeviceStatus @default(PENDING)
  firstSeenAt      DateTime     @default(now())
  lastSeenAt       DateTime     @default(now())
  approvedAt       DateTime?
  approvedByUserId String?
  approvedBy       User?        @relation("DeviceApprovedBy", fields: [approvedByUserId], references: [id])

  @@unique([userId, deviceId])
  @@index([userId, status])
}

enum DeviceStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

// Admin-configured windows a DRIVER is allowed to be logged in. Absence of
// any row for a user means unrestricted (every existing driver today) —
// there's no separate "restriction enabled" flag, so there's no state where
// the two can drift out of sync. See access-schedule.util.ts for the
// same-day-only (no overnight wrap) window check this drives.
model DriverAccessSchedule {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  dayOfWeek DayOfWeek
  startTime String // "HH:mm", 24h, interpreted in the org's timezone
  endTime   String // "HH:mm"; must be > startTime — no overnight windows in v1
  createdAt DateTime  @default(now())

  @@index([userId, dayOfWeek])
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// A driver's subscribed browser push endpoint (Web Push / VAPID). One row
