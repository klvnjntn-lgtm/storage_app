// ---- Payroll -------------------------------------------------------------

model Employee {
  id                String    @id @default(uuid())
  organizationId    String
  name              String
  position          String?
  nik               String? // employee ID number
  bankName          String?
  bankAccountNumber String?
  baseSalary        Decimal   @db.Decimal(12, 2)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  archivedAt        DateTime?
  invoices          Invoice[] // NEW — inverse relation

  organization     Organization              @relation(fields: [organizationId], references: [id])
  salaryComponents EmployeeSalaryComponent[]
  payrollItems     PayrollItem[]

  @@unique([id, organizationId]) // NEW
  @@index([organizationId])
}

enum SalaryComponentKind {
  ALLOWANCE
  DEDUCTION
}

model SalaryComponentType {
  id                String              @id @default(uuid())
  organizationId    String
  name              String // "Meal Allowance", "BPJS Kesehatan", "PPh 21", etc.
  type              SalaryComponentKind
  isTaxable         Boolean             @default(false)
  isFixed           Boolean             @default(true) // fixed amount vs percentage-based
  defaultAmount     Decimal?            @db.Decimal(12, 2)
  defaultPercentage Decimal?            @db.Decimal(5, 2)
  accountId         String? // e.g. a specific BPJS Payable / PPh21 Payable account for this deduction
  account           ChartOfAccount?     @relation(fields: [accountId], references: [id])

  organization          Organization              @relation(fields: [organizationId], references: [id])
  employeeComponents    EmployeeSalaryComponent[]
  payrollItemComponents PayrollItemComponent[]

  @@unique([organizationId, name])
}

model EmployeeSalaryComponent {
  id          String   @id @default(uuid())
  employeeId  String
  componentId String
  amount      Decimal? @db.Decimal(12, 2)
  percentage  Decimal? @db.Decimal(5, 2)

  employee  Employee            @relation(fields: [employeeId], references: [id])
  component SalaryComponentType @relation(fields: [componentId], references: [id])

  @@unique([employeeId, componentId])
}

enum PayrollPayType {
  MONTHLY
  WEEKLY
}

enum PayrollStatus {
  DRAFT
  POSTED
  PAID
  VOID
}

model Payroll {
  id             String                   @id @default(uuid())
  organizationId String
  periodMonth    Int
  periodYear     Int
  paidAt         DateTime?
  paymentMethod  PaymentMethod?
  bankAccountId  String? // NEW — which specific OrganizationBankAccount disbursement left from. Required when paymentMethod != CASH.
  bankAccount    OrganizationBankAccount? @relation(fields: [bankAccountId], references: [id])

  payType      PayrollPayType @default(MONTHLY)
  documentDate DateTime       @db.Date
  dueDate      DateTime?      @db.Date
  status       PayrollStatus  @default(DRAFT)
  createdAt    DateTime       @default(now())
  userId       String?

  organization Organization  @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  items        PayrollItem[]

  // true while the run is live, NULL once voided. Part of the unique key
  // below so a period can hold one live run but any number of voided ones
  // (Postgres treats NULLs as distinct) — without it, voiding a run left
  // that month impossible to run again.
  activeSlot Boolean? @default(true)

  @@unique([organizationId, periodYear, periodMonth, payType, activeSlot])
}

model PayrollItem {
  id              String  @id @default(uuid())
  payrollId       String
  employeeId      String
  baseSalary      Decimal @db.Decimal(12, 2)
  grossPay        Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @db.Decimal(12, 2)
  netPay          Decimal @default(0) @db.Decimal(12, 2)

  payroll    Payroll                @relation(fields: [payrollId], references: [id])
  employee   Employee               @relation(fields: [employeeId], references: [id])
  components PayrollItemComponent[]

  @@unique([payrollId, employeeId])
}

model PayrollItemComponent {
  id            String              @id @default(uuid())
  payrollItemId String
  componentId   String
  name          String // snapshot at pay time, so renaming a component later doesn't rewrite history
  type          SalaryComponentKind
  amount        Decimal             @db.Decimal(12, 2)

  payrollItem PayrollItem         @relation(fields: [payrollItemId], references: [id])
  component   SalaryComponentType @relation(fields: [componentId], references: [id])
}

// ---- Operating Expenses (electricity, rent, etc.) -------------------------

model ExpenseCategory {
  id             String @id @default(uuid())
  organizationId String
  name           String // "Electricity", "Rent", "Internet", "Insurance"...

  organization Organization    @relation(fields: [organizationId], references: [id])
  expenses     Expense[]
  accountId    String?
  account      ChartOfAccount? @relation(fields: [accountId], references: [id])

  @@unique([organizationId, name])
}

enum ExpenseStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Expense {
  id             String                   @id @default(uuid())
  organizationId String
  categoryId     String
  locationId     String?
  description    String?
  amount         Decimal                  @db.Decimal(12, 2)
  amountPaid     Decimal                  @default(0) @db.Decimal(12, 2) // FIX — tracks partial payments; see ExpensePayment
  expenseDate    DateTime                 @db.Date
  dueDate        DateTime?
  status         ExpenseStatus            @default(UNPAID)
  paidAt         DateTime?
  paymentMethod  PaymentMethod?
  createdAt      DateTime                 @default(now())
  userId         String?
  bankAccountId  String?
