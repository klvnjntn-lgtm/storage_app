  fulfillmentPath FulfillmentPath?

  locationId     String?
  format         InvoiceFormat
  status         InvoiceStatus          @default(DRAFT)
  customerName   String?
  customerPoNumber String?
  subtotal       Decimal                @default(0) @db.Decimal(12, 2)
  discount       Decimal                @default(0) @db.Decimal(12, 2)
  total          Decimal                @default(0) @db.Decimal(12, 2)
  userId         String?
  createdAt      DateTime               @default(now())
  invoiceDate    DateTime?              @db.Date
  issuedAt       DateTime?
  customerId     String?
    amountPaid     Decimal                @default(0) @db.Decimal(12, 2)   // was Int

  paymentStatus  PaymentStatus          @default(UNPAID)
  paymentTerms   String?
  dueDate        DateTime?
  taxAmount      Decimal                @default(0) @db.Decimal(12, 2)
  vehicleId      String?
  salesOrderId   String?  

  // NEW — bank account snapshot, same rationale as customerName /
  // DeliveryOrderItem.productName: a printed document shouldn't
  // silently change if the account is edited or archived later.
  bankAccountId     String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  bankAccount       OrganizationBankAccount? @relation(fields: [bankAccountId], references: [id])

