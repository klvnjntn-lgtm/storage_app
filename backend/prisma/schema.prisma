  @@index([organizationId, expenseDate])
}

// One row per installment recorded against an Expense — mirrors Payment
// (Invoice's equivalent). ExpensesService.recordPayment() is the only
// writer; each row backs one postExpensePayment() ledger entry, keyed by
// this row's own id so partial payments don't collide on one sourceId the
// way the old markPaid()-only flow did.
model ExpensePayment {
  id            String        @id @default(cuid())
  expenseId     String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)
  note          String?
  recordedById  String?
  createdAt     DateTime      @default(now())
  bankAccountId String?

  expense     Expense                  @relation(fields: [expenseId], references: [id])
  recordedBy  User?                    @relation(fields: [recordedById], references: [id])
  bankAccount OrganizationBankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([expenseId])
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

enum DepreciationMethod {
  STRAIGHT_LINE
}

// A depreciable asset — equipment, vehicles, fixtures. Acquisition always
// records the full cost against FIXED_ASSET_PAYABLE (mirrors Expense's
// record-then-pay split); FixedAssetPayment rows pay that down, same as
// ExpensePayment does for Expense. amountPaid is denormalized off those
// rows the same way Expense.amountPaid is, for the same reason: cheap
// "is this fully paid" reads without summing payments every time.
//
// accumulatedDepreciation + lastDepreciatedThrough are advanced together,
// atomically, by FixedAssetsService.runDepreciation() — lastDepreciatedThrough
// is what makes re-running that job for an already-caught-up asset a no-op
// instead of double-posting.
model FixedAsset {
  id                      String             @id @default(uuid())
  organizationId          String
  name                    String
  category                String?
  locationId              String?
  acquisitionDate         DateTime           @db.Date
  cost                    Decimal            @db.Decimal(14, 2)
  salvageValue            Decimal            @default(0) @db.Decimal(14, 2)
  usefulLifeMonths        Int
  depreciationMethod      DepreciationMethod @default(STRAIGHT_LINE)
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(14, 2)
  lastDepreciatedThrough  DateTime?          @db.Date
  amountPaid              Decimal            @default(0) @db.Decimal(14, 2)
  status                  FixedAssetStatus   @default(ACTIVE)
  disposedAt              DateTime?
  disposalProceeds        Decimal?           @db.Decimal(14, 2)
  notes                   String?
  userId                  String?
  createdAt               DateTime           @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id])
  location     Location?           @relation(fields: [locationId], references: [id])
  user         User?               @relation(fields: [userId], references: [id])
  payments     FixedAssetPayment[]

  @@index([organizationId, status])
}

// One row per installment paid toward a FixedAsset's acquisition cost —
// mirrors ExpensePayment exactly, including the reason each entry keys off
// this row's own id rather than a shared per-asset sourceId.
model FixedAssetPayment {
  id            String        @id @default(cuid())
  fixedAssetId  String
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod @default(CASH)
  note          String?
  recordedById  String?
  createdAt     DateTime      @default(now())
  bankAccountId String?

  fixedAsset  FixedAsset               @relation(fields: [fixedAssetId], references: [id])
  recordedBy  User?                    @relation(fields: [recordedById], references: [id])
  bankAccount OrganizationBankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([fixedAssetId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// Well-known accounts that posting rules look up by meaning, not by ID.
// Each org configures ChartOfAccount rows with these keys once (via a COA
// seed/setup flow); posting rules resolve through AccountResolverService
// so they never hardcode an account UUID.
enum SystemAccountKey {
  CASH
  BANK
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  INVENTORY
  SALES_REVENUE
  SALES_TAX_PAYABLE // output VAT/PPN collected from customers
  PURCHASE_TAX_RECEIVABLE // input VAT/PPN paid to suppliers, if taxEnabled
  COST_OF_GOODS_SOLD
  SALARY_EXPENSE
  PAYROLL_PAYABLE // net pay owed to employees, pre-disbursement
  PAYROLL_DEDUCTIONS_PAYABLE // fallback for deductions with no specific account (BPJS/PPh21 etc.)
  EXPENSE_PAYABLE // generic AP for operating expenses (rent, electricity) before they're paid
  UNCATEGORIZED_EXPENSE // fallback when an ExpenseCategory has no accountId set
  RETAINED_EARNINGS
  INVENTORY_ADJUSTMENT // EXPENSE, debit-normal: shrinkage, count corrections
  OPENING_BALANCE_EQUITY // EQUITY, credit-normal: stock loaded via import

  FIXED_ASSETS // ASSET, debit-normal: cost basis of fixed assets on the books
  ACCUMULATED_DEPRECIATION // ASSET, credit-normal (contra-asset): depreciation taken to date
  FIXED_ASSET_PAYABLE // LIABILITY, credit-normal: unpaid acquisition cost, mirrors EXPENSE_PAYABLE
  DEPRECIATION_EXPENSE // EXPENSE, debit-normal
  GAIN_ON_ASSET_DISPOSAL // REVENUE, credit-normal: proceeds > net book value at disposal
  LOSS_ON_ASSET_DISPOSAL // EXPENSE, debit-normal: proceeds < net book value at disposal
}

model ChartOfAccount {
  id             String                   @id @default(uuid())
  organizationId String
  code           String // e.g. "1100", "4000" — displayed/sorted account code
  name           String
  bankAccountId  String?                  @unique
  bankAccount    OrganizationBankAccount? @relation(fields: [bankAccountId], references: [id])

  type          AccountType
  normalBalance NormalBalance
  systemKey     SystemAccountKey? // null for org-specific accounts (e.g. a custom expense account)
  parentId      String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())

  organization         Organization          @relation(fields: [organizationId], references: [id])
  parent               ChartOfAccount?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children             ChartOfAccount[]      @relation("AccountHierarchy")
  journalLines         JournalEntryLine[]
  expenseCategories    ExpenseCategory[]
  salaryComponentTypes SalaryComponentType[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey]) // nullable field, many NULLs allowed — only one row per systemKey per org
  @@index([organizationId, type])
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED // no new postings; can still be reopened by an admin action
  LOCKED // permanently closed, e.g. after a tax filing — never reopened
}

model FiscalPeriod {
  id             String             @id @default(uuid())
  organizationId String
  year           Int
  month          Int
  status         FiscalPeriodStatus @default(OPEN)
  closedAt       DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  journalEntries JournalEntry[]

  @@unique([organizationId, year, month])
}

enum JournalSourceType {
  INVOICE
  PAYMENT
  PURCHASE_ORDER
  GOODS_RECEIPT
  SUPPLIER_PAYMENT
  EXPENSE
  PAYROLL
  MANUAL
  STOCK_ADJUSTMENT

  FIXED_ASSET_PURCHASE
  FIXED_ASSET_DEPRECIATION
  FIXED_ASSET_DISPOSAL
}

enum JournalEntryStatus {
  POSTED
  VOID
}

model JournalEntry {
  id             String             @id @default(uuid())
  organizationId String
  entryNumber    String?
  entryDate      DateTime           @db.Date
  memo           String?
  sourceType     JournalSourceType
  sourceId       String? // polymorphic — the Invoice/Payment/etc id. Not an FK: source lives in a different table per sourceType.
  status         JournalEntryStatus @default(POSTED)
  fiscalPeriodId String
  createdAt      DateTime           @default(now())
  userId         String?

  // Reversal pairing: never edit or delete a posted entry. To undo one,
  // create a reversing entry (debits/credits swapped) linked back here.
  reversalOfId String?       @unique
  reversalOf   JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("Reversal")

  organization Organization       @relation(fields: [organizationId], references: [id])
  fiscalPeriod FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  user         User?              @relation(fields: [userId], references: [id])
  lines        JournalEntryLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, entryDate])
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(14, 2)
  credit         Decimal @default(0) @db.Decimal(14, 2)
  description    String?
  locationId     String?

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id])
  account      ChartOfAccount @relation(fields: [accountId], references: [id])
  location     Location?      @relation(fields: [locationId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

// One POST /stock/import call. Groups its IMPORT_* events so a delivery
// can be labelled and count-checked (RECEIVE session) as a unit.
model StockImportBatch {
  id             String       @id @default(cuid())
  organizationId String
  mode           String // 'REPLACE' | 'INCREMENT' — mirrors ImportMode in stock.service.ts
  userId         String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  events         Event[]
  sessions       Session[]

  @@index([organizationId, createdAt])
}

// Organization-wide named price levels (Retail, Wholesale, Distributor,
// Member …). Exactly one per org is the default; its price for a product
// is Product.sellingPrice. Other levels' prices live in ProductPrice and
// may be blank, in which case a new sales line falls back to the default
// level's price and records the default level as its source. Levels are
// archived rather than deleted so historical lines keep their source.
model PriceLevel {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean   @default(false)
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization        Organization         @relation(fields: [organizationId], references: [id])
  productPrices       ProductPrice[]
  customers           Customer[]
  salesQuotationItems SalesQuotationItem[]
  salesOrderItems     SalesOrderItem[]
  invoiceItems        InvoiceItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ProductPrice {
  productId    String
  priceLevelId String
  price        Decimal  @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceLevel PriceLevel @relation(fields: [priceLevelId], references: [id], onDelete: Cascade)

  @@id([productId, priceLevelId])
  @@index([priceLevelId])
}

// Why a product's weighted-average cost is what it is: one row per change
// (and per goods receipt, even when the average didn't move), newest last.
enum CostChangeSource {
  GOODS_RECEIPT
  SALES_RETURN
  SALE_REVERSAL
  OPENING_IMPORT
  MANUAL
}

model ProductCostHistory {
  id             String           @id @default(cuid())
  organizationId String
  productId      String
  source         CostChangeSource
  // What caused it, e.g. a goods receipt id or "invoice:<id>".
  sourceId       String?
  previousCost   Decimal?         @db.Decimal(12, 2)
  newCost        Decimal?         @db.Decimal(12, 2)
  // Stock on hand (all locations) just before, and what came in at what cost.
  quantityBefore Decimal          @db.Decimal(12, 2)
  quantityIn     Decimal          @default(0) @db.Decimal(12, 2)
  unitCostIn     Decimal?         @db.Decimal(12, 2)
  userId         String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@index([organizationId])
}
