# Template for the root docker-compose.yml (cloud deployment). Copy to
# .env and fill in real values. Never commit the filled-in .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=waresys

DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/waresys?schema=public
OSRM_URL=http://osrm:5000
VROOM_URL=http://vroom:3000

SUPERADMIN_SECRET=
# Platform console (cloud): comma-separated owner emails. Each must also be
# granted with: docker compose exec backend node dist/src/scripts/platform-owner.js grant <email>
PLATFORM_OWNER_EMAILS=
JWT_SECRET=

LICENSE_FINGERPRINT=
LICENSE_KEY=

KEYGEN_ACCOUNT_ID=
KEYGEN_TOKEN=

PRINT_TOKEN_SECRET=

# Reachable from inside the backend container — used server-side (e.g. to
# render print/PDF pages via Puppeteer). Docker network service name, not
# a public URL.
FRONTEND_URL=http://frontend:3000
# Reachable from inside the frontend container — used by Next.js server
# components (print pages) to call the backend directly. Docker network
# service name, not a public URL.
INTERNAL_API_URL=http://backend:3000
HOST_MACHINE_GUID=

LICENSE_STATE_FILE=/data/license-state.json

# Comma-separated list of origins allowed to call the backend directly
# (cross-origin). The normal browser path never needs this — it goes
# through the frontend's same-origin /api proxy — so this only matters
# for direct backend calls (rare). Set to the real public frontend domain.
ALLOWED_ORIGINS=https://app.waresys.id

FIREBIRD_HOST=firebird
FIREBIRD_PORT=3050
FIREBIRD_USER=sysdba
FIREBIRD_PASSWORD=

FIREBIRD_LEGACY_PORT=3050
FIREBIRD_LEGACY_USER=sysdba
FIREBIRD_LEGACY_PASSWORD=

# Public API origin, used only as a build-time fallback if INTERNAL_API_URL
# is ever unset; the client never calls this directly (see frontend's /api
# proxy).
NEXT_PUBLIC_API_URL=https://api.waresys.id

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=https://app.waresys.id

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys` in
# backend/. NEXT_PUBLIC_VAPID_PUBLIC_KEY must match VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Timezone of the backend's daily jobs (payment reminders, cleanup).
# Defaults to Asia/Jakarta; the server clock itself is usually UTC.
# CRON_TZ=Asia/Jakarta

# ─── Backups (db-backup service; see ops/backup/README.md) ───
BACKUP_TZ=Asia/Jakarta
BACKUP_TIME=02:00
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Off-server copy to Google Drive — only runs with the "offsite" profile:
# COMPOSE_PROFILES=offsite
OFFSITE_REMOTE=gdrive:WareSys/backups

# ─── Uploaded files ───
# Signs short-lived links to private files (delivery proof photos).
# Falls back to JWT_SECRET when unset.
FILE_URL_SECRET=
# Delivery proof photos: target retention. Deletion stays OFF unless
# DELIVERY_PROOF_AUTO_DELETE=true (the daily job only reports).
DELIVERY_PROOF_RETENTION_DAYS=730
DELIVERY_PROOF_AUTO_DELETE=false

# ─── Self-serve billing (plans + WhatsApp top-ups) — backend/src/billing ───
# true on the public SaaS: signups get a 14-day trial, then plan limits and
# online payment apply. false (default): new orgs are hand-managed.
SELF_SERVE_BILLING=false
# Online payment (checkout + WhatsApp top-ups). Off: the billing page only
# shows prices with "coming soon"; payments are recorded by hand.
ONLINE_PAYMENTS_ENABLED=false
# Xendit: Dashboard → Settings → API keys (secret key with Money-in write)
# and Settings → Callbacks (the verification token). Point the Invoices
# callback URL at https://<your-domain>/api/billing/webhooks/xendit.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ─── WhatsApp (Meta WhatsApp Cloud API) — backend/src/messaging ───
# Each template must be approved in Meta Business Manager with a DOCUMENT
# header (except the statement) and body parameters in this order:
#   invoice:        {{1}} customer, {{2}} business, {{3}} invoice no, {{4}} total, {{5}} due date
#   purchase order: {{1}} supplier, {{2}} business, {{3}} PO no, {{4}} total
#   reminder:       {{1}} customer, {{2}} business, {{3}} invoice no, {{4}} amount due, {{5}} due date
#   statement:      {{1}} customer, {{2}} business, {{3}} period, {{4}} balance (no header)
# Off: WhatsApp sending, top-ups and reminders show as "coming soon".
WHATSAPP_ENABLED=false
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# What one message costs a business from its prepaid balance (IDR).
WA_PRICE_PER_MESSAGE=500
WA_TEMPLATE_LANGUAGE=id
WA_TEMPLATE_INVOICE=waresys_invoice
WA_TEMPLATE_PURCHASE_ORDER=waresys_purchase_order
WA_TEMPLATE_REMINDER=waresys_payment_reminder
WA_TEMPLATE_STATEMENT=waresys_statement
# Language of emailed documents and reminders: id or en.
MESSAGE_LANGUAGE=id

# Encrypts two-factor secrets at rest (any long random string). Optional —
# derived from JWT_SECRET when empty, but then rotating JWT_SECRET would
# invalidate everyone's authenticator setup.
SECRET_BOX_KEY=

# ─── Monitoring ───
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN=

# Google Maps for the delivery maps (Maps JavaScript API). Empty = Leaflet
# with OpenStreetMap tiles. Baked into the frontend at build time, so
# rebuild after changing. Restrict the key to your domain (HTTP referrers)
# and to the Maps JavaScript API in the Google Cloud console — it is
# visible to every browser. The Map ID comes from Map Management in the
# same console (needed for the markers).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# "json" for one JSON object per log line (log collectors); empty = plain.
LOG_FORMAT=

# Parts catalogue: show "what workshops install" only when at least this many different workshops agree.
PART_EVIDENCE_MIN_WORKSHOPS=2
